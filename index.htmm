<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>For Shawn 💙</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap');

:root {
  --light-blue: #eaf7ff;
  --blue: #8ed0ff;
  --dark-blue: #247fc5;
  --text: #174a70;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Nunito', sans-serif;
  color: var(--text);
  overflow: hidden;
  background: linear-gradient(135deg, #eaf7ff, #ffffff, #ccecff);
}

/* =========================
   DECORATIONS
========================= */

.decor {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.65);
  box-shadow: 0 8px 30px rgba(36,127,197,0.12);
  animation: float 7s ease-in-out infinite;
}

.b1 {
  width: 90px;
  height: 90px;
  left: 6%;
  top: 12%;
}

.b2 {
  width: 42px;
  height: 42px;
  right: 9%;
  top: 22%;
  animation-delay: 1s;
}

.b3 {
  width: 65px;
  height: 65px;
  right: 15%;
  bottom: 12%;
  animation-delay: 2s;
}

.b4 {
  width: 28px;
  height: 28px;
  left: 15%;
  bottom: 18%;
  animation-delay: 3s;
}

.star {
  position: absolute;
  font-size: 25px;
  animation: float 7s ease-in-out infinite;
}

.s1 {
  left: 10%;
  top: 42%;
}

.s2 {
  right: 12%;
  top: 50%;
  animation-delay: 2s;
}

.s3 {
  left: 24%;
  bottom: 10%;
  animation-delay: 4s;
}

.cloud {
  position: absolute;
  font-size: 58px;
  opacity: 0.65;
  animation: float 7s ease-in-out infinite;
}

.c1 {
  left: -8px;
  top: 6%;
}

.c2 {
  right: -10px;
  bottom: 7%;
  animation-delay: 2s;
}

@keyframes float {
  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-14px);
  }
}

/* =========================
   LOADING SCREEN
========================= */

#loading {
  position: fixed;
  inset: 0;
  z-index: 20;

  display: flex;
  align-items: center;
  justify-content: center;

  background: linear-gradient(
    160deg,
    #dff3ff,
    #f8fcff 55%,
    #bfe6ff
  );

  transition:
    opacity 1.6s ease,
    visibility 1.6s ease;
}

#loading.fade-out {
  opacity: 0;
  visibility: hidden;
}

.loader-card {
  width: min(680px, 90vw);
  padding: 48px 30px;
  text-align: center;

  background: rgba(255,255,255,0.72);
  border: 2px solid rgba(255,255,255,0.9);
  border-radius: 32px;

  box-shadow:
    0 25px 70px rgba(36,127,197,0.18);

  backdrop-filter: blur(10px);
}

#loaderText {
  min-height: 180px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-family: 'Baloo 2', cursive;
  font-size: clamp(1.35rem,4vw,2.15rem);
  font-weight: 600;
  line-height: 1.5;

  white-space: pre-line;
}

.typing-cursor {
  display: inline-block;
  width: 3px;
  height: 1.1em;

  background: #4da9ee;

  margin-left: 4px;
  vertical-align: middle;

  animation: blink 0.8s infinite;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

/* =========================
   MAIN WEBSITE
========================= */

#app {
  position: relative;
  z-index: 2;

  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 70px 20px 35px;

  opacity: 0;

  transition: opacity 1.3s ease;
}

#app.visible {
  opacity: 1;
}

/* =========================
   MUSIC BUTTON
========================= */

.music-btn {
  position: fixed;
  right: 18px;
  top: 18px;
  z-index: 10;

  width: 48px;
  height: 48px;

  border-radius: 50%;

  background: rgba(255,255,255,0.8);
  color: var(--dark-blue);

  box-shadow:
    0 8px 25px rgba(36,127,197,0.16);

  font-size: 1.3rem;

  transition: 0.25s;
}

.music-btn:hover {
  transform: scale(1.08) rotate(-5deg);
}

.music-btn.active {
  background: #4da9ee;
  color: white;
}

/* =========================
   BOOK
========================= */

.book {
  width: min(760px,100%);
  min-height: 560px;

  display: flex;
  flex-direction: column;
}

.page {
  flex: 1;

  display: none;

  opacity: 0;

  background: rgba(255,255,255,0.82);

  border: 2px solid rgba(255,255,255,0.9);

  border-radius: 34px;

  padding: clamp(30px,6vw,65px);

  box-shadow:
    0 25px 80px rgba(36,127,197,0.18);

  backdrop-filter: blur(12px);

  text-align: center;
}

.page.active {
  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  animation: pageIn 0.8s ease forwards;
}

.page.exit {
  animation: pageOut 0.45s ease forwards;
}

@keyframes pageIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pageOut {
  to {
    opacity: 0;
    transform: translateY(-10px);
  }
}

/* =========================
   TEXT
========================= */

.page-number {
  font-size: 0.9rem;

  font-weight: 800;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  color: #67b7ed;

  margin-bottom: 16px;
}

h1,
h2 {
  font-family: 'Baloo 2', cursive;

  margin: 0 0 18px;

  line-height: 1.05;
}

h1 {
  font-size: clamp(2.7rem,8vw,5rem);
}

h2 {
  font-size: clamp(2.1rem,6vw,3.5rem);
}

p {
  font-size: clamp(1.15rem,3vw,1.45rem);

  line-height: 1.65;

  margin: 8px 0;
}

.big {
  font-size: clamp(1.5rem,4vw,2.2rem);

  font-weight: 800;
}

.highlight {
  color: var(--dark-blue);
}

/* =========================
   BUTTONS
========================= */

.cute-button {
  margin-top: 28px;

  padding: 15px 28px;

  border-radius: 999px;

  background: #4da9ee;

  color: white;

  font-weight: 800;

  font-size: 1.05rem;

  box-shadow:
    0 10px 25px rgba(77,169,238,0.28);

  transition: 0.25s;
}

.cute-button:hover {
  transform: translateY(-3px) scale(1.03);

  box-shadow:
    0 14px 30px rgba(77,169,238,0.35);
}

.cute-button:active {
  transform: scale(0.97);
}

/* =========================
   CHECKLIST
========================= */

.checklist {
  background: rgba(234,247,255,0.75);

  padding: 20px 28px;

  border-radius: 24px;

  width: min(540px,100%);
}

.checklist p {
  margin: 13px 0;
}

.list {
  text-align: left;

  width: min(520px,100%);

  margin: 8px auto;
}

.list p {
  margin: 13px 0;
}

.achievement {
  font-size: clamp(1.5rem,4vw,2.2rem);

  font-weight: 800;

  margin: 8px 0;
}

.final-message {
  max-width: 570px;
}

.hint {
  font-size: 0.9rem;

  opacity: 0.55;

  margin-top: 22px;
}

/* =========================
   SECRET HEART
========================= */

.heart-secret {
  position: fixed;

  left: 18px;
  bottom: 18px;

  z-index: 10;

  width: 42px;
  height: 42px;

  border-radius: 50%;

  background: rgba(255,255,255,0.8);

  box-shadow:
    0 8px 25px rgba(36,127,197,0.14);

  font-size: 1.15rem;

  transition: 0.25s;
}

.heart-secret:hover {
  transform: scale(1.15);
}

/* =========================
   PAGE DOTS
========================= */

.dots {
  display: flex;

  justify-content: center;

  gap: 8px;

  margin-top: 18px;
}

.dot {
  width: 8px;
  height: 8px;

  border-radius: 50%;

  background: #b9ddf5;

  transition: 0.3s;
}

.dot.active {
  width: 24px;

  border-radius: 10px;

  background: #4da9ee;
}

/* =========================
   CONFETTI
========================= */

.confetti {
  position: fixed;

  top: -20px;

  font-size: 22px;

  z-index: 30;

  pointer-events: none;

  animation: fall 3.5s linear forwards;
}

@keyframes fall {
  to {
    transform:
      translateY(110vh)
      rotate(720deg);

    opacity: 0;
  }
}

/* =========================
   TOAST MESSAGES
========================= */

.toast {
  position: fixed;

  left: 50%;
  bottom: 28px;

  transform: translate(-50%,20px);

  opacity: 0;

  z-index: 50;

  background: white;

  padding: 18px 24px;

  border-radius: 20px;

  box-shadow:
    0 15px 45px rgba(36,127,197,0.22);

  font-weight: 800;

  text-align: center;

  max-width: 90vw;

  transition: 0.35s;
}

.toast.show {
  opacity: 1;

  transform: translate(-50%,0);
}

/* =========================
   MOBILE
========================= */

@media(max-width:600px) {

  #app {
    padding: 65px 14px 25px;
  }

  .book {
    min-height: 600px;
  }

  .page {
    border-radius: 27px;

    padding: 34px 22px;
  }

  .loader-card {
    padding: 38px 20px;
  }
}
</style>
</head>


<body>

<!-- DECORATIONS -->

<div class="decor">

  <div class="bubble b1"></div>
  <div class="bubble b2"></div>
  <div class="bubble b3"></div>
  <div class="bubble b4"></div>

  <div class="star s1">✦</div>
  <div class="star s2">✧</div>
  <div class="star s3">✦</div>

  <div class="cloud c1">☁️</div>
  <div class="cloud c2">☁️</div>

</div>


<!-- LOADING SCREEN -->

<section id="loading">

  <div class="loader-card">

    <div id="loaderText"></div>

  </div>

</section>


<!-- MUSIC BUTTON -->

<button
  class="music-btn"
  id="musicBtn"
  aria-label="Toggle music">

  ♫

</button>


<!-- MAIN WEBSITE -->

<main id="app">

<div class="book">


<!-- PAGE 1 -->

<section class="page active">

  <div class="page-number">
    📖 Page 1
  </div>

  <h2>
    ⚠️ Shawn.
  </h2>

  <p class="big">
    Stop scrolling.
  </p>

  <p>
    Yes...
  </p>

  <p class="big highlight">
    You.
  </p>

  <button class="cute-button next">
    yes mommy 🙄
  </button>

</section>


<!-- PAGE 2 -->

<section class="page">

  <div class="page-number">
    📖 Page 2
  </div>

  <h2>
    Congratulations.
  </h2>

  <p>
    You clicked a button.
  </p>

  <p class="big">
    Good boy.
  </p>

  <p>
    Gold star for you.
  </p>

  <p class="big">
    ⭐
  </p>

  <button class="cute-button next">
    Continue →
  </button>

</section>


<!-- PAGE 3 -->

<section class="page">

  <div class="page-number">
    📖 Page 3
  </div>

  <h2>
    This website exists because...
  </h2>

  <p>
    we've both been kinda annoying lately.
  </p>

  <p>
    And because I felt like making something.
  </p>

  <p class="big highlight">
    So...
  </p>

  <p class="big">
    here we are.
  </p>

  <button class="cute-button next">
    Okayyy →
  </button>

</section>


<!-- PAGE 4 -->

<section class="page">

  <div class="page-number">
    📖 Page 4
  </div>

  <h2>
    Daily Checklist
  </h2>

  <div class="checklist">

    <p>
      🍔 Eat something.
    </p>

    <p>
      💧 Drink water.
    </p>

    <p>
      😴 Sleep.
    </p>

    <p>
      🧠 Tell Ella she's pretty.
    </p>

  </div>

  <p class="hint">
    That's it.
  </p>

  <button class="cute-button next">
    Noted. 🙄
  </button>

</section>


<!-- PAGE 5 -->

<section class="page">

  <div class="page-number">
    📖 Page 5
  </div>

  <h2>
    Things you're officially banned from doing:
  </h2>

  <div class="list">

    <p>
      ❌ Ignoring me.
    </p>

    <p>
      ❌ Fighting me as well.
    </p>

    <p>
      ❌ Not telling me what's wrong.
    </p>

    <p>
      ❌ Forgetting you're actually cool (sometimes).
    </p>

  </div>

  <button class="cute-button next">
    I understand... 😔
  </button>

</section>


<!-- PAGE 6 -->

<section class="page">

  <div class="page-number">
    📖 Page 6
  </div>

  <h2>
    Achievement unlocked!
  </h2>

  <p>
    You reached the end.
  </p>

  <p class="achievement">
    +100 Happiness
  </p>

  <p class="achievement">
    +500 Aura
  </p>

  <p class="achievement">
    +1 Cool website
  </p>

  <p class="big">
    🎉
  </p>

  <button class="cute-button next">
    One last thing →
  </button>

</section>


<!-- FINAL MESSAGE -->

<section class="page">

  <div class="page-number">
    ✨ Final Message
  </div>

  <h2>
    Okay...
  </h2>

  <div class="final-message">

    <p>
      That's all.
    </p>

    <p>
      Hope this made your day
    </p>

    <p class="big highlight">
      at least
    </p>

    <p class="big">
      1%
    </p>

    <p>
      better.
    </p>

    <p class="big">
      :)
    </p>

    <p>
      Now go text me and tell me how amazing I am.
    </p>

  </div>

  <p class="hint">
    Psst... there's probably nothing else to find here. 🤍
  </p>

</section>


<!-- PAGE DOTS -->

<div class="dots" id="dots"></div>

</div>

</main>


<!-- SECRET HEART -->

<button
  class="heart-secret"
  id="heartSecret">

  🤍

</button>


<!-- TOAST -->

<div
  class="toast"
  id="toast">

</div>


<script>

/* =========================
   LOADING SEQUENCE
========================= */

const loaderText =
document.getElementById("loaderText");

const loading =
document.getElementById("loading");

const app =
document.getElementById("app");


const sequence = [

  {
    text: "Initializing...",
    pause: 1000
  },

  {
    text: "Searching database...",
    pause: 800
  },

  {
    text: "Checking if visitor is...",
    pause: 700
  },

  {
    text: "My ultra super cool daddy...",
    pause: 1000
  },

  {
    text: "Checking coolness level...",
    pause: 1000
  },

  {
    text: "Results:\n\nDebatable.",
    pause: 800
  },

  {
    text: "Identity confirmed.",
    pause: 500
  },

  {
    text: "Welcome, Shawn.",
    pause: 1300
  }

];


function sleep(ms) {

  return new Promise(
    resolve => setTimeout(resolve, ms)
  );

}


async function typeText(text, speed = 65) {

  loaderText.innerHTML = "";

  const span =
  document.createElement("span");

  const cursor =
  document.createElement("span");

  cursor.className =
  "typing-cursor";

  loaderText.appendChild(span);

  loaderText.appendChild(cursor);


  for (const char of text) {

    if (char === "\n") {

      span.innerHTML += "<br>";

    } else {

      span.textContent += char;

    }

    await sleep(speed);

  }

}


async function runLoader() {

  for (const item of sequence) {

    await typeText(item.text);

    await sleep(item.pause);

  }


  loading.classList.add("fade-out");

  await sleep(900);

  app.classList.add("visible");

}


/* =========================
   PAGE SYSTEM
========================= */

const pages =
[
  ...document.querySelectorAll(".page")
];

const dots =
document.getElementById("dots");

let current = 0;


/* CREATE DOTS */

pages.forEach(
  (_, index) => {

    const dot =
    document.createElement("div");

    dot.className =
    "dot" +
    (index === 0
      ? " active"
      : "");

    dots.appendChild(dot);

  }
);


/* CHANGE PAGE */

function showPage(next) {

  if (
    next < 0 ||
    next >= pages.length
  ) {

    return;

  }


  const oldPage =
  pages[current];

  const newPage =
  pages[next];


  oldPage.classList.remove(
    "active"
  );

  oldPage.classList.add(
    "exit"
  );


  setTimeout(
    () => {

      oldPage.classList.remove(
        "exit"
      );

      newPage.classList.add(
        "active"
      );

    },

    450
  );


  current = next;


  [
    ...dots.children
  ].forEach(
    (dot, index) => {

      dot.classList.toggle(
        "active",
        index === current
      );

    }
  );


  if (
    current ===
    pages.length - 1
  ) {

    startFinalTimer();

  }


  if (current === 5) {

    launchConfetti();

  }

}


/* BUTTONS */

document
.querySelectorAll(".next")
.forEach(
  button => {

    button.addEventListener(
      "click",
      () => {

        showPage(
          current + 1
        );

      }
    );

  }
);


/* =========================
   TOAST MESSAGES
========================= */

const toast =
document.getElementById("toast");


function showToast(message) {

  toast.textContent =
  message;

  toast.classList.add(
    "show"
  );


  clearTimeout(
    window.toastTimer
  );


  window.toastTimer =
  setTimeout(
    () => {

      toast.classList.remove(
        "show"
      );

    },

    3500
  );

}


/* =========================
   SECRET HEART
========================= */

document
.getElementById("heartSecret")
.addEventListener(
  "click",
  () => {

    showToast(
      "SECRET FOUND! 🤍 Reward: One free hug. Redeem whenever. 🫂"
    );

  }
);


/* =========================
   CLICK TITLE 5 TIMES
========================= */

let titleClicks = 0;

let titleTimer;


document
.querySelectorAll("h2")
.forEach(
  title => {

    title.addEventListener(
      "click",
      () => {

        titleClicks++;


        clearTimeout(
          titleTimer
        );


        titleTimer =
        setTimeout(
          () => {

            titleClicks = 0;

          },

          1800
        );


        if (
          titleClicks === 5
        ) {

          showToast(
            "Bro. Why are you clicking everything? Ik you miss me chillll 😭"
          );

          titleClicks = 0;

        }

      }
    );

  }
);


/* =========================
   FINAL SECRET MESSAGE
========================= */

let finalTimer;


function startFinalTimer() {

  clearTimeout(
    finalTimer
  );


  finalTimer =
  setTimeout(
    () => {

      if (
        current ===
        pages.length - 1
      ) {

        showToast(
          "...You're still here? Tell your bf I say hi. 😂"
        );

      }

    },

    20000
  );

}


/* =========================
   CONFETTI
========================= */

function launchConfetti() {

  const symbols = [
    "🎉",
    "✨",
    "💙",
    "⭐",
    "🫧",
    "🤍"
  ];


  for (
    let i = 0;
    i < 55;
    i++
  ) {

    const element =
    document.createElement(
      "div"
    );


    element.className =
    "confetti";


    element.textContent =
    symbols[
      Math.floor(
        Math.random() *
        symbols.length
      )
    ];


    element.style.left =
    Math.random() *
    100 +
    "vw";


    element.style.animationDelay =
    Math.random() *
    1.2 +
    "s";


    element.style.fontSize =
    14 +
    Math.random() *
    18 +
    "px";


    document.body.appendChild(
      element
    );


    setTimeout(
      () => {

        element.remove();

      },

      5000
    );

  }

}


/* =========================
   MUSIC
========================= */

let audioCtx = null;

let gainNode = null;

let oscillators = [];

let musicOn = false;


const musicBtn =
document.getElementById(
  "musicBtn"
);


function startMusic() {

  audioCtx =
  audioCtx ||
  new (
    window.AudioContext ||
    window.webkitAudioContext
  )();


  gainNode =
  audioCtx.createGain();


  gainNode.gain.value =
  0.025;


  gainNode.connect(
    audioCtx.destination
  );


  const notes = [
    261.63,
    329.63,
    392.00,
    329.63
  ];


  notes.forEach(
    frequency => {

      const oscillator =
      audioCtx.createOscillator();


      oscillator.type =
      "sine";


      oscillator.frequency.value =
      frequency;


      oscillator.connect(
        gainNode
      );


      oscillator.start();


      oscillators.push(
        oscillator
      );

    }
  );


  musicOn = true;


  musicBtn.classList.add(
    "active"
  );

}


function stopMusic() {

  oscillators.forEach(
    oscillator => {

      try {

        oscillator.stop();

      }

      catch (error) {}

    }
  );


  oscillators = [];


  if (gainNode) {

    gainNode.disconnect();

  }


  musicOn = false;


  musicBtn.classList.remove(
    "active"
  );

}


musicBtn.addEventListener(
  "click",
  () => {

    if (musicOn) {

      stopMusic();

    }

    else {

      startMusic();

    }

  }
);


/* START WEBSITE */

runLoader();

</script>

</body>
</html>
